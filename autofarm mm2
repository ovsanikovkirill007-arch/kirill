local function f()
    local ch = LP.Character
    if not ch then return nil end
    local r = ch:FindFirstChild("HumanoidRootPart")
    if not r then return nil end
    local cl, cd = nil, math.huge
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("BasePart") then
            local s = o.Name:lower()
            if s:find("coin") or s:find("money") or s:find("cash") or s:find("dollar") then
                if o.Transparency < 1 and o.Parent then
                    local d = (o.Position - r.Position).Magnitude
                    if d < cd and d > 0.5 then cd = d cl = o end
                end
            end
        end
    end
    return cl
end

R.Heartbeat:Connect(function()
    if not on then return end
    local ch = LP.Character
    if not ch then return end
    local r = ch:FindFirstChild("HumanoidRootPart")
    local h = ch:FindFirstChild("Humanoid")
    if not r or not h or h.Health <= 0 then return end
    if not gy then gy = r.Position.Y end
    if r.Position.Y < gy - 5 then
        r.CFrame = CFrame.new(r.Position.X, gy, r.Position.Z)
        r.Velocity = Vector3.zero
        return
    end
    h.PlatformStand = true
    r.Velocity = Vector3.zero
    r.RotVelocity = Vector3.zero
    local co = f()
    if co then
        local t = co.Position + Vector3.new(0, 1, 0)
        local d = t - r.Position
        if d.Magnitude > 0.8 then
            r.CFrame = CFrame.new(r.Position + d.Unit * math.min(0.4, d.Magnitude))
            gy = r.Position.Y
        else
            n = n + 1
            c.Text = tostring(n)
        end
    else
        r.CFrame = CFrame.new(r.Position)
    end
end)

